---
import {Icon} from 'astro-icon/components';



import { useTranslations } from '@i18n/utils';

const lang = Astro.currentLocale as 'es' | 'en';
const t = useTranslations(lang);


const email = 'idaisel@igaimportaciones.com'
const phoneNumber = '01 305 690 2553'

const {title, info, header, card, footer, form} = t.contact

const {button,footer: formFooter,placeholders,titles} = form
---

<section id="contacto" class="w-full bg-[#0f0f0f] py-20 px-6 font-sans text-gray-300">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">

    <div class="flex flex-col justify-between">
      <div>
        <p class="text-xs tracking-widest text-gray-500 uppercase mb-4">{header}</p>
        <h2 class="text-5xl md:text-6xl font-serif text-white mb-6">{title}</h2>
        <p class="text-lg text-gray-400 max-w-md mb-12 leading-relaxed">
          {info}
        </p>

        <div class="flex flex-col gap-4 max-w-md">
          
          <div class="bg-[#141414] border border-white/5 p-4 rounded flex items-center justify-between group hover:border-[#d4c4a8]/30 transition-colors">
            <div class="flex items-center gap-4">
              <div class="p-2 bg-[#1a1a1a] rounded text-[#d4c4a8]">
                <Icon name="lucide:at-sign" class="w-5 h-5" />
              </div>
              <div>
                <p class="text-[10px] tracking-widest text-gray-500 uppercase">Email</p>
                <p class="text-sm text-white">{email}</p>
              </div>
            </div>
            <a href={`mailto:>${email}<`} class="bg-[#1a1a1a] px-4 py-2 text-[10px] tracking-widest uppercase text-white rounded hover:bg-[#d4c4a8] hover:text-black transition-colors">
              {card.email.button}
            </a>
          </div>

          <div class="bg-[#141414] border border-white/5 p-4 rounded flex items-center justify-between group hover:border-[#d4c4a8]/30 transition-colors">
            <div class="flex items-center gap-4">
              <div class="p-2 bg-[#1a1a1a] rounded text-[#d4c4a8]">
                <Icon name="lucide:message-square" class="w-5 h-5" />
              </div>
              <div>
                <p class="text-[10px] tracking-widest text-gray-500 uppercase">WhatsApp</p>
                <p class="text-sm text-white">+{phoneNumber}</p>
              </div>
            </div>
            <a href={`https://wa.me/${phoneNumber}`} target="_blank" rel="noopener noreferrer" class="bg-[#1a1a1a] px-4 py-2 text-[10px] tracking-widest uppercase text-white rounded hover:bg-[#d4c4a8] hover:text-black transition-colors">
              {card.whatsapp.button}
            </a>
          </div>

        </div>
      </div>

      <p class="text-sm text-gray-500 mt-16 lg:mt-0">
        {footer}
      </p>
    </div>

    <div class="bg-[#1a1a1a] p-8 md:p-10 rounded-lg border border-white/5 shadow-2xl">
      <form class="flex flex-col gap-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label for="nombre" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">{titles.name}</label>
            <input type="text" id="nombre" placeholder={placeholders.name} class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors" required>
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">{titles.email}</label>
            <input type="email" id="email" placeholder={placeholders.email} class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors" required>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="rubro" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">{titles.product}</label>
          <input type="text" id="rubro" placeholder={placeholders.product} class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors" required>
        </div>

        <div class="flex flex-col gap-2">
          <label for="mensaje" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">{titles.message}</label>
          <textarea id="mensaje" rows="5" placeholder={placeholders.message} class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors resize-none" required></textarea>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-4">
          <button type="submit" class="w-full sm:w-auto bg-[#d4c4a8] text-[#1a1a1a] px-8 py-4 text-xs font-bold tracking-widest uppercase rounded hover:bg-[#c4b498] transition-colors flex items-center justify-center gap-2 group">
            {button}
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </button>
          
          <p class="text-[10px] tracking-widest uppercase text-gray-500">
            {formFooter}
          </p>
        </div>

      </form>
    </div>

  </div>
</section>
